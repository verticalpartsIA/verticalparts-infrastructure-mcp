# Transporte MCP
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8020

# Hostinger control plane
HOSTINGER_API_BASE=https://developers.hostinger.com
HOSTINGER_API_TOKEN=
HOSTINGER_VM_ID=

# VPS administrada
INFRA_SSH_HOST=YOUR_VPS_HOST_OR_IP
INFRA_SSH_PORT=22
INFRA_SSH_USER=infra-mcp
INFRA_SSH_KEY=/opt/verticalparts-infra-mcp/secrets/id_ed25519
INFRA_SSH_KNOWN_HOSTS=/opt/verticalparts-infra-mcp/secrets/known_hosts

# Configuração
INFRA_PROJECTS_FILE=./config/projects.yaml
INFRA_POLICIES_FILE=./config/policies.yaml
INFRA_AUDIT_LOG=./data/audit.jsonl
INFRA_ALLOWED_PATHS=/opt,/root,/etc/nginx,/etc/systemd/system,/docker

# Segurança
INFRA_ALLOW_BREAK_GLASS=false
